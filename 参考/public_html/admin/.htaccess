# りすたっち管理画面セキュリティ設定

# JSONファイルへの直接アクセスを禁止
<Files "*.json">
    Order allow,deny
    Deny from all
</Files>

# Markdownファイルへの直接アクセスを禁止
<Files "*.md">
    Order allow,deny
    Deny from all
</Files>

# PHPファイルの直接実行を制限（index.php以外）
<Files "products.php">
    Order allow,deny
    Deny from all
</Files>

<Files "shops.php">
    Order allow,deny
    Deny from all
</Files>

<Files "menu.php">
    Order allow,deny
    Deny from all
</Files>

<Files "topics.php">
    Order allow,deny
    Deny from all
</Files>

<Files "security.php">
    Order allow,deny
    Deny from all
</Files>

<Files "totp-helper.php">
    Order allow,deny
    Deny from all
</Files>

# セキュリティヘッダーの設定
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self';"
</IfModule>

# ディレクトリリスティングの無効化
Options -Indexes

# バックアップファイルの隠蔽
<Files "*.bak">
    Order allow,deny
    Deny from all
</Files>

<Files "*~">
    Order allow,deny
    Deny from all
</Files>

# エラーページの設定
ErrorDocument 403 "Access Denied"
ErrorDocument 404 "Page Not Found"