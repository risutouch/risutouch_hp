<script>
let selectedPosts = [];

function openInstagramModal() {
    document.getElementById('instagram-modal').style.display = 'flex';
    setTimeout(() => document.getElementById('instagram-modal').classList.add('active'), 10);
    checkInstagramAuthStatus();
}

// Instagram手動管理関連の関数
function checkInstagramAuthStatus() {
    fetch('instagram-handler-manual.php?action=status')
        .then(response => response.json())
        .then(data => {
            document.getElementById('instagram-auth-status').style.display = 'none';
            
            if (data.authenticated) {
                // 設定済み
                document.getElementById('instagram-authenticated').style.display = 'block';
                document.getElementById('instagram-auth-required').style.display = 'block'; // 設定画面も表示したまま
                loadInstagramProfile();
                // ユーザー名を表示
                if (data.username) {
                    document.getElementById('instagram-username').value = data.username;
                }
            } else {
                // 未設定
                document.getElementById('instagram-auth-required').style.display = 'block';
                document.getElementById('instagram-authenticated').style.display = 'none';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById('instagram-auth-status').style.display = 'none';
            document.getElementById('instagram-auth-required').style.display = 'block';
        });
}

function switchTab(tabName) {
    // タブボタンのアクティブ状態を更新
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    
    // タブコンテンツの表示を切り替え
    document.querySelectorAll('.tab-content').forEach(content => content.style.display = 'none');
    document.getElementById('tab-' + tabName).style.display = 'block';
}

function addSinglePost() {
    const username = document.getElementById('instagram-username').value.trim();
    const caption = document.getElementById('post-caption').value.trim();
    const image = document.getElementById('post-image').value.trim();
    const url = document.getElementById('post-url').value.trim();
    const date = document.getElementById('post-date').value;
    
    if (!caption && !image) {
        alert('投稿文または画像URLを入力してください');
        return;
    }
    
    const formData = new FormData();
    if (username) formData.append('username', username);
    formData.append('caption', caption);
    formData.append('image', image);
    formData.append('url', url);
    formData.append('date', date);
    
    // ユーザー名が入力されている場合は先に設定
    const promises = [];
    if (username) {
        promises.push(
            fetch('instagram-handler-manual.php?action=set_username', {
                method: 'POST',
                body: new FormData().append('username', username)
            })
        );
    }
    
    // 投稿を追加
    fetch('instagram-handler-manual.php?action=add_post', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('投稿を追加しました！');
            // フォームをクリア
            document.getElementById('post-caption').value = '';
            document.getElementById('post-image').value = '';
            document.getElementById('post-url').value = '';
            checkInstagramAuthStatus();
        } else {
            alert('投稿の追加に失敗しました: ' + (data.error || '不明なエラー'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('投稿追加中にエラーが発生しました');
    });
}

function addMultiplePosts() {
    const postsJson = document.getElementById('posts-json').value.trim();
    
    if (!postsJson) {
        alert('投稿データを入力してください');
        return;
    }
    
    const formData = new FormData();
    formData.append('posts_json', postsJson);
    
    fetch('instagram-handler-manual.php?action=add_multiple', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            document.getElementById('posts-json').value = '';
            checkInstagramAuthStatus();
        } else {
            alert('一括追加に失敗しました: ' + (data.error || '不明なエラー'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('一括追加中にエラーが発生しました');
    });
}

function showJSONExample() {
    const example = [
        {
            "caption": "新商品のどんぐりケーキができました！ #どんぐりケーキ #新商品",
            "image": "https://example.com/donguri-cake.jpg",
            "url": "https://instagram.com/p/ABC123",
            "date": "2024-01-15"
        },
        {
            "caption": "はちみつクッキーの焼き上がり！ #はちみつクッキー #手作り",
            "image": "https://example.com/honey-cookie.jpg", 
            "url": "https://instagram.com/p/DEF456",
            "date": "2024-01-14"
        }
    ];
    
    document.getElementById('posts-json').value = JSON.stringify(example, null, 2);
    alert('形式例を入力しました。この形式で投稿データを入力してください。');
}

function generateSampleData() {
    fetch('instagram-handler-manual.php?action=generate_sample', {
        method: 'POST'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            checkInstagramAuthStatus();
        } else {
            alert('サンプルデータ生成に失敗しました: ' + (data.error || '不明なエラー'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('サンプルデータ生成中にエラーが発生しました');
    });
}

function setInstagramUsername() {
    const username = document.getElementById('instagram-username').value.trim();
    
    if (!username) {
        alert('Instagramユーザー名を入力してください');
        return;
    }
    
    const formData = new FormData();
    formData.append('username', username);
    
    fetch('instagram-handler-rss.php?action=set_username', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Instagramユーザー名を設定しました！');
            checkInstagramAuthStatus();
        } else {
            alert('設定の保存に失敗しました: ' + (data.error || '不明なエラー'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('設定中にエラーが発生しました');
    });
}

function testInstagramRSS() {
    const username = document.getElementById('instagram-username').value.trim();
    
    if (!username) {
        alert('まずInstagramユーザー名を設定してください');
        return;
    }
    
    fetch('instagram-handler-rss.php?action=test_rss')
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('RSS接続テスト成功！\n\n' + 
                  'URL: ' + data.url + '\n' +
                  'データサイズ: ' + data.content_length + ' bytes\n\n' +
                  '投稿取得を実行してください。');
        } else {
            alert('RSS接続テスト失敗: ' + (data.error || '不明なエラー') + '\n\n' +
                  '原因:\n' +
                  '1. ユーザー名が間違っている\n' +
                  '2. アカウントが非公開\n' +
                  '3. RSSサービスがダウン\n\n' +
                  'URL: ' + (data.url || ''));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('テスト中にエラーが発生しました');
    });
}

function fetchInstagramRSS() {
    const button = event.target;
    const originalText = button.textContent;
    button.textContent = '取得中...';
    button.disabled = true;
    
    fetch('instagram-handler-rss.php?action=fetch_rss')
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Instagram投稿を取得しました！\n\n' + data.message);
            checkInstagramAuthStatus();
        } else {
            alert('投稿の取得に失敗しました: ' + (data.error || '不明なエラー'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('取得中にエラーが発生しました');
    })
    .finally(() => {
        button.textContent = originalText;
        button.disabled = false;
    });
}

function fetchPostsViaBrowser() {
    const token = document.getElementById('instagram-token').value.trim();
    const pageId = document.getElementById('instagram-page-id').value.trim();
    
    if (!token || !pageId) {
        alert('アクセストークンとページIDを入力してください');
        return;
    }
    
    // まずはme/accountsでFacebookページを取得
    const accountsUrl = `https://developers.facebook.com/tools/explorer/?method=GET&path=me%2Faccounts&version=v18.0&access_token=${encodeURIComponent(token)}`;
    
    const newWindow = window.open(accountsUrl, 'graph_api_explorer', 'width=1200,height=800');
    
    // 使用方法を説明
    setTimeout(() => {
        alert(`Graph API Explorerが開きました。\n\n【手順1: Facebook Page IDを取得】\n1. 「Submit」ボタンをクリック\n2. レスポンスからあなたのFacebookページのIDをコピー\n3. 下の「Facebook Page ID」欄に貼り付け\n\n【手順2: Instagram投稿を取得】\n4. 新しいリクエストで {page_id}?fields=instagram_business_account を実行\n5. instagram_business_account の id をメモ\n6. {instagram_business_account_id}/media を実行\n7. fields=id,caption,media_type,media_url,thumbnail_url,permalink,timestamp を設定\n8. レスポンスをコピーして下記に入力`);
        
        // テキストエリアを表示
        showPostsInputArea();
    }, 2000);
}

function showPostsInputArea() {
    const authDiv = document.getElementById('instagram-auth-required');
    
    // 既存の入力エリアがある場合は削除
    const existingArea = document.getElementById('posts-input-area');
    if (existingArea) {
        existingArea.remove();
    }
    
    const inputArea = document.createElement('div');
    inputArea.id = 'posts-input-area';
    inputArea.style.cssText = 'margin-top: 20px; padding: 15px; border: 1px solid #ddd; background: #f9f9f9;';
    
    inputArea.innerHTML = `
        <h4>1. アカウント情報を入力:</h4>
        <p style="font-size: 14px; color: #666;">
            まず {instagram_business_account_id}?fields=id,username,media_count のレスポンスを入力してください
        </p>
        <textarea id="account-json-input" placeholder='{"id":"17841234","username":"your_bakery","media_count":25}' 
                  style="width: 100%; height: 100px; padding: 8px; margin-bottom: 10px; font-family: monospace; font-size: 12px;"></textarea>
        <button type="button" class="btn btn-info" onclick="processAccountInfo()">アカウント情報を保存</button>
        
        <h4 style="margin-top: 20px;">2. 投稿データを入力:</h4>
        <p style="font-size: 14px; color: #666;">
            次に {instagram_business_account_id}/media のレスポンス全体をコピーしてください
        </p>
        <textarea id="posts-json-input" placeholder='{"data":[{"id":"123","caption":"投稿文","media_type":"IMAGE","media_url":"https://...","permalink":"https://...","timestamp":"2024-01-01T00:00:00+0000"}],"paging":{...}}' 
                  style="width: 100%; height: 200px; padding: 8px; margin-bottom: 10px; font-family: monospace; font-size: 12px;"></textarea>
        <button type="button" class="btn btn-success" onclick="processPastedPosts()">投稿データを処理</button>
        <button type="button" class="btn btn-secondary" onclick="showExampleFormat()" style="margin-left: 10px;">形式例を表示</button>
    `;
    
    authDiv.appendChild(inputArea);
}

function processPastedPosts() {
    const jsonInput = document.getElementById('posts-json-input').value.trim();
    
    if (!jsonInput) {
        alert('投稿データを入力してください');
        return;
    }
    
    try {
        const data = JSON.parse(jsonInput);
        
        // データ形式をチェック
        if (!data.data || !Array.isArray(data.data)) {
            alert('無効なデータ形式です。Graph API Explorerからのレスポンスをそのまま貼り付けてください。');
            return;
        }
        
        // 投稿データを保存
        const formData = new FormData();
        formData.append('posts', JSON.stringify(data.data));
        
        fetch('instagram-handler-browser.php?action=save_posts', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                alert(`${result.posts.length}件の投稿を保存しました！`);
                checkInstagramAuthStatus();
                // 入力エリアを隠す
                document.getElementById('posts-input-area').style.display = 'none';
            } else {
                alert('投稿データの保存に失敗しました: ' + (result.error || '不明なエラー'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('データ処理中にエラーが発生しました');
        });
        
    } catch (e) {
        alert('JSONデータの形式が正しくありません: ' + e.message);
    }
}

function showExampleFormat() {
    const example = {
        "data": [
            {
                "id": "17841234567890123",
                "caption": "美味しいケーキができました！ #ケーキ #手作り",
                "media_type": "IMAGE",
                "media_url": "https://scontent.cdninstagram.com/v/...",
                "permalink": "https://www.instagram.com/p/ABC123/",
                "timestamp": "2024-01-15T10:30:00+0000"
            },
            {
                "id": "17841234567890124",
                "caption": "新商品のクッキーです 🍪",
                "media_type": "IMAGE", 
                "media_url": "https://scontent.cdninstagram.com/v/...",
                "permalink": "https://www.instagram.com/p/DEF456/",
                "timestamp": "2024-01-14T15:20:00+0000"
            }
        ],
        "paging": {
            "cursors": {
                "before": "...",
                "after": "..."
            }
        }
    };
    
    document.getElementById('posts-json-input').value = JSON.stringify(example, null, 2);
    alert('形式例を入力しました。この形式でGraph API Explorerからのレスポンスを貼り付けてください。');
}

function processAccountInfo() {
    const accountInput = document.getElementById('account-json-input').value.trim();
    
    if (!accountInput) {
        alert('アカウント情報を入力してください');
        return;
    }
    
    try {
        const accountData = JSON.parse(accountInput);
        
        // 必須フィールドをチェック
        if (!accountData.id || !accountData.username) {
            alert('id と username フィールドが必要です');
            return;
        }
        
        // アカウント情報を保存
        const formData = new FormData();
        formData.append('account_info', JSON.stringify(accountData));
        
        fetch('instagram-handler-browser.php?action=save_account_info', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                alert('アカウント情報を保存しました！続いて投稿データを入力してください。');
                checkInstagramAuthStatus(); // プロフィール情報を更新
            } else {
                alert('アカウント情報の保存に失敗しました: ' + (result.error || '不明なエラー'));
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('アカウント情報処理中にエラーが発生しました');
        });
        
    } catch (e) {
        alert('アカウント情報のJSONデータの形式が正しくありません: ' + e.message);
    }
}

function loadInstagramProfile() {
    fetch('instagram-handler-manual.php?action=profile')
        .then(response => response.json())
        .then(data => {
            if (data.success && data.profile) {
                document.getElementById('instagram-username').textContent = `@${data.profile.username} (${data.profile.media_count}投稿)`;
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
}

function fetchInstagramPosts() {
    const button = event.target;
    button.textContent = '取得中...';
    button.disabled = true;
    
    fetch('instagram-handler-manual.php?action=media&limit=25')
        .then(response => response.json())
        .then(data => {
            if (data.success && data.posts) {
                displayInstagramPosts(data.posts);
            } else {
                console.error('Instagram API Error:', data);
                console.log('Error details:', JSON.stringify(data, null, 2));
                
                let errorMsg = '投稿の取得に失敗しました: ' + (data.error || '不明なエラー');
                if (data.debug) {
                    errorMsg += '\n\nデバッグ情報:';
                    if (data.debug.page_response) {
                        errorMsg += '\nページレスポンス: ' + JSON.stringify(data.debug.page_response);
                    }
                    if (data.debug.media_response) {
                        errorMsg += '\nメディアレスポンス: ' + JSON.stringify(data.debug.media_response);
                    }
                    if (data.debug.url) {
                        errorMsg += '\nリクエストURL: ' + data.debug.url;
                    }
                }
                alert(errorMsg);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('投稿の取得中にエラーが発生しました');
        })
        .finally(() => {
            button.textContent = '最新の投稿を取得';
            button.disabled = false;
        });
}

function displayInstagramPosts(posts) {
    const container = document.querySelector('.instagram-posts') || createPostsContainer();
    container.innerHTML = '';
    
    posts.forEach(post => {
        const postElement = document.createElement('div');
        postElement.className = 'instagram-post';
        postElement.onclick = () => selectPost(postElement, post.id);
        
        postElement.innerHTML = `
            <img src="${post.image}" alt="Instagram post">
            <div class="instagram-post-caption">${post.caption.substring(0, 100)}${post.caption.length > 100 ? '...' : ''}</div>
            <div class="instagram-post-date">${post.date}</div>
            <input type="hidden" name="post_data" value="${encodeURIComponent(JSON.stringify(post))}">
        `;
        
        container.appendChild(postElement);
    });
    
    // 追加ボタンを表示
    const addButton = document.getElementById('add-posts-button') || createAddButton();
    addButton.style.display = 'block';
}

function createPostsContainer() {
    const container = document.createElement('div');
    container.className = 'instagram-posts';
    document.querySelector('#instagram-authenticated').appendChild(container);
    return container;
}

function createAddButton() {
    const buttonContainer = document.createElement('div');
    buttonContainer.style.cssText = 'padding: 20px; text-align: center;';
    
    const button = document.createElement('button');
    button.id = 'add-posts-button';
    button.type = 'button';
    button.className = 'btn btn-primary';
    button.onclick = addSelectedPosts;
    button.textContent = '選択した投稿をお知らせに追加';
    button.style.display = 'none';
    
    buttonContainer.appendChild(button);
    document.querySelector('#instagram-authenticated').appendChild(buttonContainer);
    
    return button;
}

function logoutInstagram() {
    if (confirm('Instagram連携を解除してもよろしいですか？')) {
        fetch('instagram-handler-manual.php?action=logout')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    checkInstagramAuthStatus();
                    alert('Instagram連携を解除しました');
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
    }
}

function selectPost(element, postId) {
    element.classList.toggle('selected');
    
    if (element.classList.contains('selected')) {
        if (!selectedPosts.includes(postId)) {
            selectedPosts.push(postId);
        }
    } else {
        selectedPosts = selectedPosts.filter(id => id !== postId);
    }
}

function addSelectedPosts() {
    if (selectedPosts.length === 0) {
        alert('投稿を選択してください');
        return;
    }
    
    // Create form to submit selected posts
    const form = document.createElement('form');
    form.method = 'POST';
    form.style.display = 'none';
    
    selectedPosts.forEach(postId => {
        const postElement = document.querySelector(`[onclick*="${postId}"]`);
        const postData = JSON.parse(postElement.querySelector('input[name="post_data"]').value);
        
        // Create hidden inputs for each post
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'save_news';
        input.value = '1';
        form.appendChild(input);
        
        ['title', 'description', 'image', 'date', 'source', 'sourceUrl'].forEach(field => {
            const fieldInput = document.createElement('input');
            fieldInput.type = 'hidden';
            fieldInput.name = field;
            
            switch(field) {
                case 'title':
                    fieldInput.value = postData.caption.substring(0, 50) + '...';
                    break;
                case 'description':
                    fieldInput.value = postData.caption;
                    break;
                case 'image':
                    fieldInput.value = postData.image;
                    break;
                case 'date':
                    fieldInput.value = postData.date;
                    break;
                case 'source':
                    fieldInput.value = 'instagram';
                    break;
                case 'sourceUrl':
                    fieldInput.value = postData.url;
                    break;
            }
            form.appendChild(fieldInput);
        });
    });
    
    document.body.appendChild(form);
    form.submit();
}

function openNewsModal(newsId = null) {
    const modal = document.getElementById('news-modal');
    const title = document.getElementById('news-modal-title');
    const form = modal.querySelector('form');
    
    if (newsId) {
        title.textContent = 'お知らせを編集';
        // Load news data
        <?php foreach ($news['news'] as $newsItem): ?>
        if (newsId === '<?php echo $newsItem['id']; ?>') {
            document.getElementById('news-id').value = '<?php echo $newsItem['id']; ?>';
            document.getElementById('news-title').value = '<?php echo htmlspecialchars($newsItem['title']); ?>';
            document.getElementById('news-description').value = '<?php echo htmlspecialchars($newsItem['description']); ?>';
            document.getElementById('news-image').value = '<?php echo htmlspecialchars($newsItem['image']); ?>';
            document.getElementById('news-date').value = '<?php echo htmlspecialchars($newsItem['date']); ?>';
            document.getElementById('news-published').checked = <?php echo $newsItem['published'] ? 'true' : 'false'; ?>;
            document.getElementById('news-source').value = '<?php echo htmlspecialchars($newsItem['source']); ?>';
            document.getElementById('news-source-url').value = '<?php echo htmlspecialchars($newsItem['sourceUrl']); ?>';
        }
        <?php endforeach; ?>
    } else {
        title.textContent = 'お知らせを追加';
        form.reset();
        document.getElementById('news-id').value = '';
        document.getElementById('news-date').value = new Date().toISOString().split('T')[0];
    }
    
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('active'), 10);
}

function editNews(newsId) {
    openNewsModal(newsId);
}
</script>